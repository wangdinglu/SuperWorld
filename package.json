{
  "name": "superworld",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @superworld/server --filter @superworld/web dev",
    "build": "pnpm --filter @superworld/web --filter @superworld/server build",
    "start": "pnpm --filter @superworld/server start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && depcruise apps packages --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:content": "tsx tools/validate-content.ts",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm validate:content && pnpm test",
    "bots": "tsx tools/bots.ts",
    "avatar:sprout": "tsx tools/avatars/sprout.ts"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@superworld/protocol": "workspace:*",
    "@superworld/schema": "workspace:*",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
